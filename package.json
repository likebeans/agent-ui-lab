{
  "name": "agent-ui-lab",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx scripts/runtime.ts dev",
    "dev:server": "tsx scripts/runtime.ts dev:server",
    "dev:web": "tsx scripts/runtime.ts dev:web",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "build:pages": "npm run typecheck && vite build --mode pages",
    "preview": "tsx scripts/runtime.ts preview",
    "preview:pages": "tsx scripts/runtime.ts preview:pages",
    "test:pages": "playwright test --config playwright.pages.config.ts",
    "start": "tsx scripts/runtime.ts start",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "screenshots:readme": "tsx scripts/capture-readme.mjs",
    "check": "npm run test && npm run build",
    "format": "prettier --write src server shared tests e2e docs scripts config .github *.json *.ts *.html *.md",
    "format:check": "prettier --check src server shared tests e2e docs scripts config .github *.json *.ts *.html *.md"
  },
  "dependencies": {
    "@ag-ui/core": "1.0.3",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/core": "2.3.1",
    "@modelcontextprotocol/express": "2.0.2",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "express": "5.3.0",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/express": "^5.0.0",
    "@types/node": "^25.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "esbuild": "0.28.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "~5.9.3",
    "vite": "8.3.5",
    "vitest": "4.0.18"
  }
}

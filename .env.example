# Copy to .env.local in each checkout/worktree and choose distinct free ports.
# Process environment > .env.local > .env > defaults.
LAB_WEB_PORT=5173
LAB_API_PORT=3100
LAB_PREVIEW_PORT=4173
# Optional; default is a stable hash of this checkout's canonical path.
# LAB_INSTANCE_ID=my-lab
# Reserved for future persistence; W0 does not create a database.
LAB_DATA_DIR=.lab-data
# Explicit opt-in to reuse your own dev server during Playwright tests.
# Health and HTML instance identity are verified even when reusing.
# LAB_REUSE_EXISTING_SERVER=1
